# ASH - DBMS Learning Platform Environment Configuration
# Copy this file to .env for local testing (Do NOT commit real keys to Git!)

# Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (e.g. gemini-3.1-flash-lite, gemini-3-flash-preview)
GEMINI_MODEL=gemini-3.1-flash-lite

# Application Environment: development | production
APP_ENV=development
